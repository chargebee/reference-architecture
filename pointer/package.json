{
  "name": "pointer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lambda": "esbuild workers/chargebee-webhook-lambda.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --outfile=dist/lambda/index.js --external:pg-native",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate-usage.ts && npx --yes @better-auth/cli@latest migrate -y",
    "db:migrate:local": "tsx --env-file=.env.local scripts/migrate-usage.ts && npx --yes @better-auth/cli@latest migrate -y",
    "bootstrap:chargebee": "tsx --env-file=.env.local scripts/bootstrap-chargebee.ts",
    "worker:chargebee": "tsx --env-file=.env.local workers/chargebee-webhook-worker.ts",
    "reconcile:entitlements": "tsx --env-file=.env.local scripts/reconcile-entitlements.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1118.0",
    "@aws-sdk/client-sqs": "^3.1118.0",
    "@aws-sdk/credential-providers": "^3.1118.0",
    "@chargebee/better-auth": "^1.2.0",
    "@chargebee/entitlements": "0.1.0-alpha.2",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@xyflow/react": "^12.11.5",
    "ai": "^7.0.79",
    "better-auth": "1.6.30",
    "chargebee": "^3.31.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.5",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sqs-consumer": "^15.0.3",
    "uuid": "^14.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
