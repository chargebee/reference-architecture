# Required: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public base URL of the app (used for OAuth redirects and email links)
BETTER_AUTH_URL=http://localhost:3000

# Chargebee (test site for local dev)
CHARGEBEE_SITE=
CHARGEBEE_API_KEY=
# Optional: Basic Auth for the auto-mounted /api/auth/chargebee/webhook endpoint.
# Only required if the Chargebee dashboard webhook is configured with these.
CHARGEBEE_WEBHOOK_USERNAME=
CHARGEBEE_WEBHOOK_PASSWORD=

# Postgres connection string (matches docker-compose.yaml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pointer

# LocalStack
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack accepts any credentials, but the AWS SDK still requires some to
# sign requests. These are throwaway values used only for local dev.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Use the same host as AWS_ENDPOINT_URL so the SDK doesn't warn about the
# QueueUrl host differing from the resolved endpoint on every poll.
CHARGEBEE_WEBHOOK_SQS_QUEUE_URL=http://localhost:4566/000000000000/pointer-queue
CHARGEBEE_WEBHOOK_DLQ_URL=http://localhost:4566/000000000000/pointer-dlq

# OpenRouter serves every model in config/models.yaml. Key from
# https://openrouter.ai/keys. Required by POST /api/generate.
OPENROUTER_API_KEY=

# Entitlement lookups read Redis first, then the durable PostgreSQL mirror,
# then Chargebee. The cache TTL bounds how long Redis may lag the mirror; the
# snapshot TTL decides when a stored snapshot is refreshed in the background.
ENTITLEMENTS_CACHE_TTL_SECONDS=300
ENTITLEMENTS_SNAPSHOT_TTL_SECONDS=86400

# SQS queue for Chargebee webhook ingestion. It also carries entitlement sync
# jobs queued after subscription-created webhooks establish their local rows.
CHARGEBEE_WEBHOOK_SQS_QUEUE_URL=

# SQS dead-letter queue. The worker routes poison (unprocessable) messages here
# explicitly; exhausted-retry messages are moved here by the queue's redrive
# policy. Required by the worker.
CHARGEBEE_WEBHOOK_DLQ_URL=

# Buffers a usage event per generation in Redis and flushes it to Chargebee's
# batch ingest API from the worker. Leave false until the site has Advanced
# Usage Based Billing switched on (Settings > Configure Chargebee > Billing
# LogIQ) and `pnpm bootstrap:chargebee` has created the meters. While false,
# nothing is buffered, the flush loop does not start, and /api/usage/history
# returns 503.
CHARGEBEE_USAGE_INGEST_ENABLED=false

# Idle gap between flush passes. A pass that leaves a backlog reschedules
# immediately, so this is the floor on latency, not the drain rate. Keep it well
# under Chargebee's 12-hour backdating window.
USAGE_FLUSH_INTERVAL_MS=60000

# Usage history is stored in PostgreSQL unless this is set to `s3`. This is a
# deployment switch, not a dual-write mode; changing it does not copy history.
USAGE_METRICS_STORE=postgres

# Required when USAGE_METRICS_STORE=s3. DuckDB writes Hive-partitioned Parquet
# under s3://<bucket>/<prefix>/subscription_id=<id>/dt=<day>/.
USAGE_LAKE_BUCKET=pointer-usage-local
USAGE_LAKE_PREFIX=usage
USAGE_LAKE_MEMORY_LIMIT=256MB
USAGE_LAKE_THREADS=2

# --- Local development with LocalStack (docker-compose `localstack` service) ---
# Uncomment these to route SQS at the LocalStack container instead of AWS.
# The init scripts provision the queues and `pointer-usage-local` bucket.
# AWS_ENDPOINT_URL=http://localhost:4566
# USAGE_LAKE_S3_ENDPOINT=http://localhost:4566
# AWS_REGION=us-east-1
# CHARGEBEE_WEBHOOK_SQS_QUEUE_URL=http://localhost:4566/000000000000/pointer-queue
# CHARGEBEE_WEBHOOK_DLQ_URL=http://localhost:4566/000000000000/pointer-dlq
# LocalStack accepts any credentials, but the AWS SDK still needs some to sign
# requests. Use throwaway values (leave AWS_PROFILE unset).
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# No auth token is needed: the compose service is pinned to localstack 4.14.0,
# the last release that runs offline without a LocalStack account.
